---
// Warm orange light-leak glows. Place inside a `position: relative; overflow: hidden` section.
interface Props {
  variant?: 'hero' | 'about';
}
const { variant = 'hero' } = Astro.props;
---

<div class:list={['leaks', variant]} aria-hidden="true">
  <span class="leak a"></span>
  <span class="leak b"></span>
  <span class="leak c"></span>
</div>

<style>
  .leaks {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }
  .leak {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    mix-blend-mode: screen;
    animation: drift 14s ease-in-out infinite alternate;
  }
  .a {
    width: 55vmax;
    height: 45vmax;
    left: -18vmax;
    top: -10vmax;
    background: radial-gradient(closest-side, rgba(255, 140, 70, 0.32), rgba(160, 90, 40, 0.12) 60%, transparent);
  }
  .b {
    width: 45vmax;
    height: 40vmax;
    right: -16vmax;
    bottom: -14vmax;
    background: radial-gradient(closest-side, rgba(255, 122, 61, 0.24), rgba(120, 70, 40, 0.1) 60%, transparent);
    animation-delay: -6s;
  }
  .c {
    width: 22vmax;
    height: 22vmax;
    right: 12%;
    top: 8%;
    background: radial-gradient(closest-side, rgba(255, 190, 120, 0.1), transparent);
    animation-duration: 18s;
  }
  .about .a {
    left: auto;
    right: -20vmax;
    top: -6vmax;
  }
  .about .b {
    right: auto;
    left: -18vmax;
    bottom: -20vmax;
    opacity: 0.7;
  }
  @keyframes drift {
    to {
      transform: translate3d(3vmax, 2vmax, 0) scale(1.08);
    }
  }
</style>
