---
import { brandGroups } from '../data/brands';
---

<div class="groups">
  {
    brandGroups.map((group) => (
      <div class="group">
        <p class="label group-label">
          {group.label} <span class="count">· {String(group.brands.length).padStart(2, '0')}</span>
        </p>
        <ul class="grid">
          {group.brands.map((brand) => {
            const content = brand.logo ? (
              <img src={brand.logo} alt={brand.name} loading="lazy" decoding="async" />
            ) : (
              <span class="name">{brand.name}</span>
            );
            return (
              <li>
                {brand.project ? (
                  <a class="cell linked" href={`/work/${brand.project}`}>
                    {content}
                    <span class="mono tag">./project ↗</span>
                  </a>
                ) : (
                  <span class="cell">{content}</span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .groups {
    display: grid;
    gap: clamp(36px, 5vw, 56px);
  }
  .group-label {
    margin: 0 0 14px;
  }
  .count {
    color: var(--cream-faint);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    border-top: 1px solid var(--line);
  }
  .cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    min-height: 76px;
    padding-block: 16px;
  }
  .name {
    font-family: var(--f-head);
    font-weight: 700;
    text-transform: lowercase;
    letter-spacing: -0.05em;
    font-size: clamp(19px, 2vw, 23px);
    line-height: 1;
    transition: color 0.2s;
  }
  .cell img {
    max-height: 32px;
    max-width: 140px;
    object-fit: contain;
    object-position: left center;
    opacity: 0.85;
    transition: opacity 0.2s;
  }
  .tag {
    font-size: 9px;
    color: var(--accent);
    opacity: 0.75;
    transition: opacity 0.2s, transform 0.2s;
  }
  .cell:hover .name,
  .linked:focus-visible .name {
    color: var(--accent);
  }
  .linked:hover img {
    opacity: 1;
  }
  .linked:hover .tag {
    opacity: 1;
    transform: translateX(3px);
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cell {
      min-height: 64px;
      padding-block: 14px;
    }
  }
</style>
