---
import Base from '../../layouts/Base.astro';
import LoopVideo from '../../components/LoopVideo.astro';
import SocialEmbed from '../../components/SocialEmbed.astro';
import FilmStrip from '../../components/FilmStrip.astro';
import { projects, pad, type Project } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, index: i },
  }));
}

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const next = projects[(index + 1) % projects.length];
const details: [string, string][] = [
  ['Client', project.client],
  ['My role', project.role.join(' · ')],
  ['Deliverables', project.deliverables],
  ['Year', project.year],
];
---

<Base
  title={`${project.client} — ${project.title} | ${site.name}`}
  description={project.summary}
  image={project.heroPoster ?? project.thumbnail}
  variant="project"
>
  <section class="hero">
    <LoopVideo src={project.heroVideo} poster={project.heroPoster} tint={project.tint} />
    <div class="shade" aria-hidden="true"></div>
    <div class="hero-text">
      <div>
        <p class="label">Project {pad(index + 1)} / {pad(projects.length)}</p>
        <h1>{project.brand}</h1>
        <p class="subtitle">{project.title}</p>
      </div>
      {
        project.mainVideo && (
          <a class="play" href="#watch" aria-label="Jump to the video">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5.5v13l10.5-6.5z" />
            </svg>
          </a>
        )
      }
    </div>
  </section>

  <section class="info wrap">
    <dl class="details">
      {
        details.map(([k, v]) => (
          <div>
            <dt class="mono">{k}</dt>
            <dd class="mono">{v}</dd>
          </div>
        ))
      }
    </dl>
    <div class="story">
      <h2>{project.hook}</h2>
      {project.story.map((p) => <p>{p}</p>)}
      {project.note && <p class="note hand">{project.note} →</p>}
    </div>
  </section>

  {
    project.mainVideo && (
      <section id="watch" class="watch wrap" aria-label="Main video">
        <p class="label">./watch</p>
        <div class:list={['main', { wide: !/instagram|tiktok|shorts/.test(project.mainVideo) }]}>
          <SocialEmbed url={project.mainVideo} title={`${project.client} — ${project.title}`} />
        </div>
      </section>
    )
  }

  {
    project.reels.length > 0 && (
      <section class="reels wrap" aria-label="More reels">
        <p class="label">./more-reels</p>
        <div class="reel-row">
          {project.reels.map((url, i) => (
            <SocialEmbed url={url} title={`${project.client} reel ${i + 2}`} vertical />
          ))}
        </div>
      </section>
    )
  }

  <FilmStrip />
  <a class="next wrap" href={`/work/${next.slug}`}>
    <span class="label">Next project →</span>
    <span class="next-name">{next.brand}</span>
    <span class="next-sub">{next.summary}</span>
  </a>
  <FilmStrip />
</Base>

<style>
  /* HERO */
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
    background: #111;
  }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.25), transparent 25%, transparent 50%, rgba(10, 14, 12, 0.85));
  }
  .hero-text {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding: 0 var(--gutter) calc(clamp(28px, 5vw, 48px) + env(safe-area-inset-bottom));
  }
  h1 {
    margin-top: 10px;
    font-size: clamp(52px, 12vw, 132px);
    line-height: 0.85;
    padding-bottom: 0.06em;
    overflow-wrap: anywhere;
  }
  .subtitle {
    margin: 8px 0 0;
    font-size: clamp(14px, 1.6vw, 16px);
    color: var(--cream-dim);
  }
  .play {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(48px, 6vw, 56px);
    height: clamp(48px, 6vw, 56px);
    border-radius: 50%;
    background: var(--cream);
    transition: transform 0.2s;
  }
  .play:hover {
    transform: scale(1.08);
  }
  .play svg {
    width: 38%;
    fill: var(--bg);
  }

  /* INFO */
  .info {
    display: grid;
    grid-template-columns: minmax(180px, 220px) 1fr;
    gap: clamp(28px, 5vw, 64px);
    padding-block: clamp(48px, 7vw, 80px);
  }
  .details {
    margin: 0;
  }
  .details div {
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }
  .details div:first-child {
    padding-top: 0;
  }
  dt {
    font-size: 9px;
    color: var(--cream-faint);
  }
  dd {
    margin: 6px 0 0;
    font-size: 11px;
    letter-spacing: 0.02em;
    text-transform: none;
    line-height: 1.5;
  }
  .story h2 {
    font-size: clamp(28px, 3.6vw, 40px);
    line-height: 1;
    letter-spacing: -0.05em;
    text-transform: none;
  }
  .story p {
    max-width: 40em;
    margin: 18px 0 0;
    color: var(--cream-dim);
  }
  .story .note {
    color: var(--accent);
    font-size: 24px;
  }
  @media (max-width: 700px) {
    .info {
      grid-template-columns: 1fr;
    }
    .details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 20px;
      order: 2;
    }
    .details div:nth-child(2) {
      padding-top: 0;
    }
  }

  /* VIDEO */
  .watch,
  .reels {
    padding-bottom: clamp(48px, 7vw, 80px);
  }
  .watch .label,
  .reels .label {
    margin: 0 0 16px;
  }
  .main {
    max-width: 420px;
    margin-inline: auto;
  }
  .main.wide {
    max-width: none;
  }
  .reel-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 22px);
  }
  @media (max-width: 760px) {
    /* swipeable row on phones */
    .reel-row {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .reel-row::-webkit-scrollbar {
      display: none;
    }
    .reel-row > :global(*) {
      flex: 0 0 72%;
      scroll-snap-align: start;
    }
  }

  /* NEXT */
  .next {
    display: block;
    padding-block: clamp(48px, 8vw, 96px);
  }
  .next-name {
    display: block;
    margin-top: 10px;
    font-family: var(--f-head);
    font-weight: 700;
    letter-spacing: -0.06em;
    font-size: clamp(48px, 10vw, 120px);
    line-height: 0.85;
    padding-bottom: 0.06em;
    transition: color 0.2s, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .next:hover .next-name {
    color: var(--accent);
    transform: translateX(10px);
  }
  .next-sub {
    display: block;
    margin-top: 10px;
    font-size: 14px;
    color: var(--cream-dim);
  }
</style>
