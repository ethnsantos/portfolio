---
import Base from '../layouts/Base.astro';
import LightLeak from '../components/LightLeak.astro';
import FilmStrip from '../components/FilmStrip.astro';
import {
  servicesIntro,
  serviceGroups,
  addOns,
  howItWorks,
  servicesFinePrint,
  bookCallHref,
  inquiryHref,
} from '../data/services';
import { site } from '../data/site';
---

<Base
  title={`Services | ${site.name}`}
  description="Cinematic short-form video packages for businesses, brands, and music artists in the Bay Area: monthly content, social media management, ads, campaigns, and release visuals."
  current="services"
>
  <!-- INTRO -->
  <section class="intro">
    <LightLeak variant="hero" />
    <div class="intro-inner wrap">
      <p class="label">{servicesIntro.label}</p>
      <h1>{servicesIntro.title}</h1>
      <p class="lede">{servicesIntro.text}</p>
      <nav class="jump mono" aria-label="Jump to">
        {serviceGroups.map((g) => <a href={`#${g.id}`}>{g.title} ↓</a>)}
        <a href="#add-ons">add-ons ↓</a>
      </nav>
    </div>
  </section>

  <!-- PACKAGES -->
  {
    serviceGroups.map((group) => (
      <section id={group.id} class="group wrap" aria-labelledby={`${group.id}-title`}>
        <div class="group-head">
          <p class="label">{group.label}</p>
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          <p class="group-intro">{group.intro}</p>
        </div>
        <div class="cards">
          {group.packages.map((pkg) => (
            <>
              <article class:list={['card', { featured: pkg.featured }]}>
                {pkg.featured && <p class="badge mono">Most Popular</p>}
                <h3>{pkg.name}</h3>
                <p class="price">
                  <span class="prefix mono">{pkg.pricePrefix}</span>
                  <span class="amount">{pkg.price}</span>
                  {pkg.priceNote && <span class="price-note mono">{pkg.priceNote}</span>}
                </p>
                <ul class="items">
                  {pkg.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
              {group.note && group.note.after === pkg.name && (
                <p class="save mono">
                  <span class="dot" aria-hidden="true" />
                  {group.note.text}
                </p>
              )}
            </>
          ))}
        </div>
      </section>
    ))
  }

  <!-- ADD-ONS -->
  <section id="add-ons" class="group wrap" aria-labelledby="add-ons-title">
    <div class="group-head">
      <p class="label">./add-ons</p>
      <h2 id="add-ons-title">add-ons</h2>
    </div>
    <ul class="addons">
      {
        addOns.map((a) => (
          <li>
            <span class="addon-name">{a.name}</span>
            <span class="addon-price mono">{a.price}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- HOW IT WORKS -->
  <section class="group wrap" aria-labelledby="how-title">
    <div class="group-head">
      <p class="label">./how-it-works</p>
      <h2 id="how-title">how it works</h2>
    </div>
    <ol class="steps">
      {
        howItWorks.map((s, i) => (
          <li>
            <span class="step-num mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="step-name">{s.step}</span>
            <span class="step-text">{s.text}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- CTA -->
  <FilmStrip />
  <section class="cta">
    <LightLeak variant="about" />
    <div class="cta-inner wrap">
      <p class="hand kicker">ready when you are</p>
      <h2>let's make<br />something.</h2>
      <p class="fine">{servicesFinePrint}</p>
      <div class="buttons">
        <a class="btn" href={bookCallHref}>Book a Call <span aria-hidden="true">↗</span></a>
        <a class="btn ghost" href={inquiryHref}>Send an Inquiry <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <FilmStrip />
</Base>

<style>
  /* INTRO */
  .intro {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--nav-h) + env(safe-area-inset-top));
  }
  .intro-inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(56px, 9vw, 110px) clamp(32px, 5vw, 56px);
  }
  .label {
    margin: 0 0 10px;
  }
  h1 {
    font-size: clamp(52px, 11vw, 120px);
    line-height: 0.85;
    padding-bottom: 0.06em;
  }
  .lede {
    max-width: 36em;
    margin: clamp(18px, 3vw, 28px) 0 0;
    font-size: clamp(15px, 1.8vw, 18px);
    color: var(--cream-dim);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    margin-top: clamp(24px, 4vw, 36px);
    font-size: 11px;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .jump a {
    padding-block: 10px;
    color: var(--cream-dim);
    transition: color 0.2s;
  }
  .jump a:hover {
    color: var(--accent);
  }

  /* GROUPS */
  .group {
    padding-block: clamp(48px, 7vw, 88px) 0;
    scroll-margin-top: var(--nav-h);
  }
  .group-head {
    margin-bottom: clamp(22px, 3.5vw, 36px);
  }
  .group-head h2 {
    font-size: clamp(36px, 5.6vw, 58px);
  }
  .group-intro {
    max-width: 34em;
    margin: 12px 0 0;
    color: var(--cream-dim);
  }

  /* CARDS */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
    gap: clamp(14px, 2vw, 20px);
    align-items: stretch;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(20px, 2.4vw, 26px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(10, 28, 22, 0.72);
    transition:
      border-color 0.2s,
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .card:hover {
    border-color: rgba(242, 237, 228, 0.3);
  }
  .card.featured {
    border-color: var(--accent);
    background:
      radial-gradient(120% 70% at 100% 0%, rgba(255, 122, 61, 0.1), transparent 60%),
      rgba(10, 28, 22, 0.82);
    box-shadow: 0 0 0 1px rgba(255, 122, 61, 0.25), 0 18px 40px -24px rgba(255, 122, 61, 0.55);
  }
  .badge {
    position: absolute;
    top: 0;
    right: clamp(16px, 2vw, 22px);
    translate: 0 -50%;
    margin: 0;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--accent);
    color: #1a120c;
    font-size: 9px;
    font-weight: 500;
  }
  h3 {
    font-size: clamp(24px, 2.4vw, 28px);
    letter-spacing: -0.05em;
    overflow-wrap: anywhere;
  }
  .price {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 14px 0 0;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .prefix,
  .price-note {
    font-size: 9px;
    color: var(--cream-faint);
  }
  .price-note {
    color: var(--accent);
  }
  .amount {
    font-family: var(--f-head);
    font-weight: 700;
    letter-spacing: -0.04em;
    font-size: clamp(26px, 2.8vw, 32px);
    line-height: 1;
    color: var(--cream);
  }
  .featured .amount {
    color: var(--accent);
  }
  .items {
    display: grid;
    gap: 9px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 1.45;
    color: var(--cream-dim);
  }
  .items li {
    position: relative;
    padding-left: 18px;
  }
  .items li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1px solid var(--accent);
  }

  /* 3-month note: spans the full row under the business packages */
  .save {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 12px 16px;
    border: 1px dashed rgba(255, 122, 61, 0.5);
    border-radius: var(--radius);
    font-size: 11px;
    color: var(--cream);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .save .dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  /* ADD-ONS */
  .addons {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    column-gap: clamp(24px, 4vw, 48px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .addons li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    padding-block: 16px;
    border-top: 1px solid var(--line);
  }
  .addon-name {
    font-size: 15px;
  }
  .addon-price {
    font-size: 11px;
    color: var(--accent);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* HOW IT WORKS */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--accent);
  }
  .step-num {
    font-size: 10px;
    color: var(--accent);
  }
  .step-name {
    font-family: var(--f-head);
    font-weight: 700;
    letter-spacing: -0.05em;
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1;
    text-transform: lowercase;
  }
  .step-text {
    font-size: 14px;
    color: var(--cream-dim);
  }
  @media (max-width: 860px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 28px;
    }
  }
  @media (max-width: 440px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  /* CTA */
  .cta {
    position: relative;
    overflow: hidden;
    margin-top: clamp(64px, 9vw, 110px);
  }
  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(64px, 10vw, 120px);
  }
  .kicker {
    margin: 0;
    color: var(--accent);
    font-size: clamp(22px, 3vw, 26px);
    transform: rotate(-4deg);
  }
  .cta h2 {
    margin: 4px 0 0;
    font-size: clamp(54px, 11vw, 112px);
    line-height: 0.86;
  }
  .fine {
    max-width: 32em;
    margin: clamp(20px, 3vw, 28px) 0 0;
    color: var(--cream-dim);
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 14px;
    margin-top: clamp(24px, 4vw, 32px);
  }
  .btn.ghost {
    background: transparent;
    color: var(--cream);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .btn.ghost:hover {
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }
</style>
