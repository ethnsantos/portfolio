---
import type { Project } from '../data/projects';
import { pad } from '../data/projects';

interface Props {
  project: Project;
  index: number;
  /** Page this card links to. Defaults to the client-work page. */
  href?: string;
  spec?: boolean;
}
const { project, index, href = `/work/${project.slug}`, spec = false } = Astro.props;
const thumb = project.thumbnail ?? project.heroPoster;
---

<a class="card" href={href}>
  <div class="thumb" style={`--tint:${project.tint}`}>
    {thumb && <img src={thumb} alt="" width="800" height="500" loading="lazy" decoding="async" />}
    {
      project.cardVideo && (
        <video data-src={project.cardVideo} muted loop playsinline preload="none" aria-hidden="true" />
      )
    }
    {spec && <span class="spec-tag mono">spec ad</span>}
  </div>
  <div class="meta">
    <h3>{project.brand}</h3>
    <span class="num mono">{pad(index + 1)}</span>
  </div>
  <p>{project.summary}</p>
</a>

<script>
  // Desktop: the clip plays while the card is hovered or focused.
  // Phones/tablets: it plays while the card is mostly on screen.
  // Nothing downloads until then, and Save-Data / reduced-motion visitors keep the still.
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const skip = conn?.saveData || matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (!skip) {
    const play = (video: HTMLVideoElement) => {
      if (!video.src) {
        video.muted = true;
        video.src = video.dataset.src!;
      }
      video.play().catch(() => {});
    };
    const stop = (video: HTMLVideoElement) => {
      video.pause();
      video.classList.remove('on');
    };

    const videos = document.querySelectorAll<HTMLVideoElement>('.card video[data-src]');
    videos.forEach((video) => {
      video.addEventListener('playing', () => video.classList.add('on'));
      if (canHover) {
        const card = video.closest('.card')!;
        card.addEventListener('pointerenter', () => play(video));
        card.addEventListener('pointerleave', () => stop(video));
        card.addEventListener('focusin', () => play(video));
        card.addEventListener('focusout', () => stop(video));
      }
    });

    if (!canHover) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) play(video);
            else if (video.src) stop(video);
          }
        },
        { threshold: 0.6 },
      );
      videos.forEach((video) => io.observe(video));
    }
  }
</script>

<style>
  .card {
    display: block;
  }
  .thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 20% 0%, color-mix(in srgb, var(--tint) 100%, white 8%), transparent 70%),
      linear-gradient(170deg, var(--tint), #141816);
    border: 1px solid rgba(242, 237, 228, 0.06);
  }
  .thumb img,
  .thumb video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .thumb video {
    opacity: 0;
    transition:
      opacity 0.35s ease,
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .thumb video:global(.on) {
    opacity: 1;
  }
  .spec-tag {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--accent);
    color: #1a120c;
    font-size: 9px;
    font-weight: 500;
  }
  .card:hover .thumb img,
  .card:hover .thumb video {
    transform: scale(1.04);
  }
  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
  }
  h3 {
    font-size: clamp(20px, 2vw, 22px);
    letter-spacing: -0.05em;
  }
  .card:hover h3 {
    color: var(--accent);
  }
  .num {
    font-size: 9px;
    color: var(--cream-faint);
  }
  p {
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--cream-dim);
  }
</style>
