---
// A row of film sprocket holes.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['filmstrip', className]} aria-hidden="true"></div>

<style>
  .filmstrip {
    height: 20px;
    background:
      repeating-linear-gradient(
          90deg,
          rgba(242, 237, 228, 0.26) 0 12px,
          transparent 12px 30px
        )
        8px 50% / 100% 10px no-repeat,
      rgba(0, 0, 0, 0.22);
    border-block: 1px solid rgba(242, 237, 228, 0.05);
  }
</style>
