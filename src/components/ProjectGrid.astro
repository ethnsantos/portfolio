---
import ProjectCard from './ProjectCard.astro';
import { pad, yearRange, type Project } from '../data/projects';

interface Props {
  title: string;
  list: Project[];
  /** 'spec' links cards to /spec/<slug> and tags them "spec ad". */
  kind?: 'work' | 'spec';
  /** Heading level: h1 on its own page, h2 inside the homepage. */
  as?: 'h1' | 'h2';
  /** Optional line under the heading. */
  intro?: string;
}
const { title, list, kind = 'work', as: Heading = 'h2', intro } = Astro.props;
const range = yearRange(list);
const noun = kind === 'spec' ? 'spec project' : 'project';
---

<div class="work-head">
  <Heading class="title">
    <svg class="folder" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.6l2 2.2h8.4A1.5 1.5 0 0 1 21 8.7v9.8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z" />
    </svg>
    {title}
  </Heading>
  {
    list.length > 0 && (
      <p class="mono count">
        {pad(list.length)} {noun}{list.length === 1 ? '' : 's'}
        {range && ` · ${range}`}
      </p>
    )
  }
</div>
{intro && <p class="intro">{intro}</p>}
<div class="grid">
  {
    list.map((project, i) => (
      <ProjectCard project={project} index={i} href={`/${kind}/${project.slug}`} spec={kind === 'spec'} />
    ))
  }
</div>
<slot />

<style>
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  .title {
    display: flex;
    align-items: center;
    gap: 0.25em;
    font-size: clamp(40px, 6vw, 58px);
  }
  .folder {
    width: 0.62em;
    height: 0.62em;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linejoin: round;
    margin-top: 0.08em;
  }
  .intro {
    max-width: 34em;
    margin: calc(clamp(24px, 4vw, 40px) * -0.5) 0 clamp(28px, 4vw, 40px);
    color: var(--cream-dim);
  }
  .count {
    margin: 0;
    font-size: 9px;
    color: var(--cream-faint);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 3.5vw, 40px) clamp(16px, 2vw, 22px);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

</style>
