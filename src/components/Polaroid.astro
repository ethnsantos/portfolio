---
interface Props {
  /** Leave out to show a "[ photo ]" placeholder. */
  src?: string;
  srcSmall?: string;
  alt: string;
  caption: string;
  tilt?: number;
  eager?: boolean;
  class?: string;
  /** Adds an orange push-pin at the top. */
  pinned?: boolean;
  placeholder?: string;
}
const {
  src,
  srcSmall,
  alt,
  caption,
  tilt = -4,
  eager = false,
  class: className,
  pinned = false,
  placeholder = 'photo',
} = Astro.props;
const srcset = srcSmall ? `${srcSmall} 480w, ${src} 800w` : undefined;
---

<figure class:list={['polaroid', className]} style={`--tilt:${tilt}deg`}>
  {pinned && <span class="pin" aria-hidden="true" />}
  <div class="photo">
    {
      src ? (
        <img
          src={src}
          srcset={srcset}
          sizes="(max-width: 600px) 64vw, 300px"
          alt={alt}
          width="800"
          height="800"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
        />
      ) : (
        <span class="placeholder-label">[ {placeholder} ]</span>
      )
    }
  </div>
  <figcaption class="hand">{caption}</figcaption>
</figure>

<style>
  .polaroid {
    position: relative;
    margin: 0;
    width: min(300px, 68vw);
    padding: 14px 14px 0;
    background: #f2ede4;
    border-radius: 2px;
    transform: rotate(var(--tilt));
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 30px 60px -20px rgba(0, 0, 0, 0.7),
      0 12px 24px -12px rgba(0, 0, 0, 0.6);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .polaroid:hover {
    transform: rotate(calc(var(--tilt) * 0.4)) scale(1.02);
  }
  .pin {
    position: absolute;
    top: -7px;
    left: 50%;
    z-index: 1;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffb08a, var(--accent) 45%, #b8481a);
    box-shadow: 0 3px 4px rgba(0, 0, 0, 0.45);
  }
  .photo {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: #262a28;
    overflow: hidden;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    color: #1d1d1b;
    text-align: center;
    font-size: clamp(20px, 5vw, 24px);
    line-height: 1;
    padding: 18px 0 22px;
  }
</style>
